# .env.example — Copy to .env and fill in your values
# =====================================================
# Never commit the real .env file to version control.

# --- Database ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/nxtbus

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Location Provider ---
# phone_gps   = driver mobile app (MVP default)
# hardware_gps = Teltonika FMB920 hardware units (production)
# simulated   = deterministic fake data (testing only)
LOCATION_PROVIDER=phone_gps

# --- Model Paths ---
MODEL_PATH=./models/eta_v2_xgb.pkl
METADATA_PATH=./models/metadata.json

# --- Serving ---
HOST=0.0.0.0
PORT=8001
WORKERS=2

# --- Logging ---
LOG_LEVEL=INFO

# --- MLflow ---
MLFLOW_TRACKING_URI=./mlruns
MLFLOW_EXPERIMENT_NAME=nxtbus_eta_prediction

# --- v1 Rule-based Constants (optional, defaults are good) ---
# DWELL_TIME_PER_STOP_MINUTES=0.75
# SPEED_FLOOR_KMH=15.0
# SPEED_FALLBACK_KMH=25.0
# ROLLING_SPEED_WINDOW=10

# --- v2 Activation Thresholds (optional, defaults are good) ---
# V2_ACTIVATION_THRESHOLD=5000
# V2_ACTIVATION_WINDOW_DAYS=14
