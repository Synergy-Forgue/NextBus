# NXTBus Backend — Environment Configuration
# Copy this file to .env and fill in your values.
# The .env file is git-ignored and should never be committed.

# ── Server ────────────────────────────────────────────────────────────────────
# Port the HTTP + WebSocket server listens on
PORT=3000

# ── PostgreSQL Database ───────────────────────────────────────────────────────
# Host: use 'localhost' for local dev, your cloud DB host for production
DB_HOST=localhost
# PostgreSQL default port
DB_PORT=5432
# Database name (must exist before running npm run setup-db)
DB_NAME=nxtbus
# PostgreSQL superuser or a dedicated nxtbus user
DB_USER=postgres
# The password you set during PostgreSQL installation
DB_PASSWORD=your_password_here

# ── Simulator (Optional) ──────────────────────────────────────────────────────
# Override the WebSocket URL the simulator connects to (default: local backend)
SIM_WS_URL=ws://localhost:3000/ws/publish
# How often the simulator sends a GPS tick in milliseconds (default: 2000)
SIM_TICK_MS=2000
